# ==============================================================================
# fileconvr Root Environment Configuration Template
# NOTE: Replace placeholder values with environment-specific secrets.
# Do NOT commit production secrets to version control.
# ==============================================================================

# Backend Service Configuration
PORT=5000
NODE_ENV=development

# Frontend Client & CORS Configuration
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://staging.fileconvr.com,https://fileconvr.com

# Supabase Authentication & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-only:
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"

# Frontend Vite Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Storage & File Lifecycle
TEMP_STORAGE_DIR=./storage/temp
FILE_TTL_MINUTES=60
MAX_FILE_SIZE_BYTES=104857600

# Executable Runtime Paths
# CHROME_PATH=/usr/bin/google-chrome-stable
# PYTHON_PATH=/usr/bin/python3
PYTHON_PATH=python

# AI Intelligence Features (Optional)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
