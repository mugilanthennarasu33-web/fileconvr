# ==============================================================================
# fileconvr Environment Configuration Template
# NOTE: Replace placeholder values with environment-specific secrets.
# Do NOT commit production secrets to version control.
# ==============================================================================

# Core Application Settings
PORT=5000
NODE_ENV=development

# Web Client and CORS Configuration
CLIENT_URL=http://localhost:5173
# Comma-separated list of origins allowed by CORS in production/staging
ALLOWED_ORIGINS=http://localhost:5173,https://staging.fileconvr.com,https://fileconvr.com

# Supabase Authentication & Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Current publishable API key (safe for browser and server client initialization)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-only service role key (NEVER expose to frontend or browser)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase PostgreSQL Database Configuration (Prisma)
# Retrieved from Supabase Dashboard -> Project Settings -> Database -> Connection string
# For production with Supabase connection pooling (port 6543 or 5432):
# Session mode / Transaction pooler:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"
# Direct connection (for running Prisma migrations):
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Storage & Temporary File Lifecycle
TEMP_STORAGE_DIR=./storage/temp
FILE_TTL_MINUTES=60
MAX_FILE_SIZE_BYTES=104857600

# Executable Engine Paths (Leave commented or adjust for container/Linux deployment)
# CHROME_PATH=/usr/bin/google-chrome-stable
# EDGE_PATH=/usr/bin/microsoft-edge
# PYTHON_PATH=/usr/bin/python3
PYTHON_PATH=python

# AI PDF Intelligence Integration (Optional)
# Supported providers: 'gemini' | 'openai'
# If unconfigured, the application returns 503 SERVICE_UNAVAILABLE with honest status
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
